<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="600" viewBox="0 0 1200 600">
  <defs>
    <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#2b2144"/>
      <stop offset="1" stop-color="#1f2a3a"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#g)" />
  <g fill="#cfe0ff" font-family="Inter, Arial, sans-serif">
    <text x="60" y="120" font-size="56" font-weight="700">Chart Maker</text>
    <text x="60" y="170" font-size="20" opacity="0.9">Transform your text into beautiful diagrams using AI.</text>
  </g>
  <rect x="60" y="220" width="1080" height="300" rx="12" fill="#0f1a26" opacity="0.55" />
  <text x="80" y="260" fill="#9fb4ff" font-size="18">SOURCE CONTENT</text>
  <text x="80" y="300" fill="#8ea4c9" font-size="16">Paste or type your text here...</text>
  <text x="960" y="540" fill="#bfc9d6" font-size="14">Demo screenshot placeholder</text>
</svg>
